# ============================================================
# 阿里云 SLS MCP Server 环境变量配置
# 
# 使用方式：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改 .env 中的值为你自己的配置
#   3. 确保 .env 不会被提交到 Git（已在 .gitignore 中配置）
# ============================================================

# ============================================================
# 阿里云认证配置（必填）
# ============================================================

# 阿里云 AccessKey ID
# 获取方式：登录阿里云控制台 → 右上角头像 → AccessKey 管理 → 创建 AccessKey
# 安全提示：建议使用 RAM 子账号，仅赋予 SLS 读权限
ALICLOUD_ACCESS_KEY_ID=your-access-key-id

# 阿里云 AccessKey Secret
# 获取方式：创建 AccessKey 时显示，请妥善保存，之后无法再次查看
# 安全提示：切勿将此密钥泄露或提交到代码仓库
ALICLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# 阿里云区域（可选）
# 默认值：cn-hangzhou
# 可选值：cn-hangzhou, cn-beijing, cn-shanghai, cn-shenzhen 等
# 说明：根据你的 SLS 项目所在区域填写
ALICLOUD_REGION=cn-hangzhou

# ============================================================
# 运行模式配置（必填）
# ============================================================

# 运行模式
# 可选值：mcp | daemon
# - mcp:    MCP Server 模式，通过 stdio 与 OpenCode 等客户端通信
# - daemon: 守护进程模式，定时轮询获取 error 日志
RUN_MODE=mcp

# ============================================================
# 守护进程模式专用配置（仅 RUN_MODE=daemon 时生效）
# ============================================================

# SLS 项目名称（守护进程模式必填）
# 获取方式：登录阿里云 SLS 控制台 → 查看项目列表
SLS_PROJECT=your-sls-project-name

# SLS 日志库名称（守护进程模式必填）
# 获取方式：进入项目 → 查看日志库列表
SLS_LOGSTORE=your-sls-logstore-name

# 轮询间隔（可选）
# 默认值：300（秒，即 5 分钟）
# 说明：每次查询的时间间隔，不建议设置过短（< 60秒）以避免 API 限流
POLL_INTERVAL=300

# Error 日志查询语句（可选）
# 默认值：level: ERROR
# 说明：SLS 查询语法，用于过滤需要监控的日志
# 示例：
#   level: ERROR                    # 查询 ERROR 级别日志
#   level: ERROR OR level: FATAL    # 查询 ERROR 或 FATAL 级别
#   status: 500 AND path: /api      # 查询 API 500 错误
ERROR_QUERY=level: ERROR

# 输出方式（可选）
# 默认值：console
# 可选值：console | file
# - console: 输出到控制台（标准输出）
# - file:    输出到日志文件（需配置 LOG_FILE_PATH）
DAEMON_OUTPUT=console

# 日志文件路径（可选，仅 DAEMON_OUTPUT=file 时生效）
# 默认值：./logs/error.log
# 说明：程序会自动创建目录（如果不存在）
LOG_FILE_PATH=./logs/error.log

# ============================================================
# Smart Query LLM 增强配置（可选）
# ============================================================

# 是否启用 LLM 增强
# 默认值：false
# 说明：启用后，当本地解析失败时会调用 LLM 进行智能转换
ENABLE_LLM_QUERY=false

# LLM API Key（启用 LLM 时必填）
# 获取方式：登录阿里云百炼控制台 → API Key 管理
# 支持：DashScope、OpenAI 等兼容 OpenAI API 格式的服务
LLM_API_KEY=your-llm-api-key

# LLM API 基础 URL（可选）
# 默认值：https://dashscope.aliyuncs.com/compatible-mode/v1
# 说明：使用其他 LLM 服务时修改此项
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型名称（可选）
# 默认值：qwen-plus
# 可选值：qwen-plus, qwen-max, gpt-3.5-turbo, gpt-4 等
LLM_MODEL=qwen-plus
